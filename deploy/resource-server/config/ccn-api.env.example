POSTGRES_DB=ccn
POSTGRES_USER=ccn
POSTGRES_PASSWORD=<generate-a-high-entropy-secret>
DATABASE_URL=postgresql+psycopg://ccn:<url-encoded-postgres-password>@postgres:5432/ccn
REDIS_PASSWORD=<generate-a-high-entropy-secret>
REDIS_URL=redis://:<url-encoded-redis-password>@redis:6379/0
CCN_API_KEY=<generate-a-256-bit-api-key>
ENABLE_API_DOCS=false
AUTH_FAIL_LIMIT_PER_MINUTE=10
READ_LIMIT_PER_MINUTE=120
WRITE_LIMIT_PER_MINUTE=30
